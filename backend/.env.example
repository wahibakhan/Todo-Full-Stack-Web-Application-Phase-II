# Better Auth Secret
# Generate a secure random string (minimum 32 characters)
# Must match frontend BETTER_AUTH_SECRET exactly
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here

# Neon PostgreSQL Database URL
# Get this from your Neon dashboard (use pooler URL for better performance)
# Format: postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Environment
# Options: development, production
ENVIRONMENT=production

# CORS Origins
# For local development: http://localhost:3001
# For Railway deployment: Add your Railway frontend URL
# Example: ["https://your-app.up.railway.app"]
CORS_ORIGINS=["http://localhost:3001"]
